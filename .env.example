# Zelim maintenance portal environment variables.
# Copy to .env.local for development. Real values live in Vercel project
# settings. For a staging setup, duplicate the Airtable base and point the
# Preview environment's AIRTABLE_BASE_ID at the copy so QA never touches
# production data.

# Airtable (server-side only; never exposed to the client)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_SWIFT_TABLE=swift_units

# Session cookie signing
SESSION_SECRET=

# Cloudinary signed uploads
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Report emails
RESEND_API_KEY=

# Rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: voice transcription. Guarded in-handler so voice input degrades
# gracefully to manual text entry when unset.
ELEVENLABS_API_KEY=

# Optional: what3words location for submissions, useful at sea where street
# addresses fail. Guarded in-handler; without it the field is simply blank.
W3W_API_KEY=
